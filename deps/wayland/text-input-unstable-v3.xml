<?xml version="1.0" encoding="UTF-8"?>
<protocol name="text_input_unstable_v3">
  <interface name="zwp_text_input_v3" version="1">
    <description summary="text input">Compositor mediated text input.</description>

    <enum name="change_cause">
      <entry name="input_method" value="0"/>
      <entry name="other" value="1"/>
    </enum>
    <enum name="content_hint" bitfield="true">
      <entry name="none" value="0x0"/>
      <entry name="completion" value="0x1"/>
      <entry name="spellcheck" value="0x2"/>
      <entry name="auto_capitalization" value="0x4"/>
      <entry name="lowercase" value="0x8"/>
      <entry name="uppercase" value="0x10"/>
      <entry name="titlecase" value="0x20"/>
      <entry name="hidden_text" value="0x40"/>
      <entry name="sensitive_data" value="0x80"/>
      <entry name="latin" value="0x100"/>
      <entry name="multiline" value="0x200"/>
    </enum>
    <enum name="content_purpose">
      <entry name="normal" value="0"/>
      <entry name="alpha" value="1"/>
      <entry name="digits" value="2"/>
      <entry name="number" value="3"/>
      <entry name="phone" value="4"/>
      <entry name="url" value="5"/>
      <entry name="email" value="6"/>
      <entry name="name" value="7"/>
      <entry name="password" value="8"/>
      <entry name="pin" value="9"/>
      <entry name="date" value="10"/>
      <entry name="time" value="11"/>
      <entry name="datetime" value="12"/>
      <entry name="terminal" value="13"/>
    </enum>

    <request name="destroy" type="destructor"/>
    <request name="enable"/>
    <request name="disable"/>
    <request name="set_surrounding_text">
      <arg name="text" type="string"/>
      <arg name="cursor" type="int"/>
      <arg name="anchor" type="int"/>
    </request>
    <request name="set_text_change_cause">
      <arg name="cause" type="uint" enum="change_cause"/>
    </request>
    <request name="set_content_type">
      <arg name="hint" type="uint" enum="content_hint"/>
      <arg name="purpose" type="uint" enum="content_purpose"/>
    </request>
    <request name="set_cursor_rectangle">
      <arg name="x" type="int"/>
      <arg name="y" type="int"/>
      <arg name="width" type="int"/>
      <arg name="height" type="int"/>
    </request>
    <request name="commit"/>

    <event name="enter">
      <arg name="surface" type="object" interface="wl_surface"/>
    </event>
    <event name="leave">
      <arg name="surface" type="object" interface="wl_surface"/>
    </event>
    <event name="preedit_string">
      <arg name="text" type="string" allow-null="true"/>
      <arg name="cursor_begin" type="int"/>
      <arg name="cursor_end" type="int"/>
    </event>
    <event name="commit_string">
      <arg name="text" type="string" allow-null="true"/>
    </event>
    <event name="delete_surrounding_text">
      <arg name="before_length" type="uint"/>
      <arg name="after_length" type="uint"/>
    </event>
    <event name="done">
      <arg name="serial" type="uint"/>
    </event>
  </interface>

  <interface name="zwp_text_input_manager_v3" version="1">
    <description summary="text input manager">Creates text input objects.</description>
    <request name="destroy" type="destructor"/>
    <request name="get_text_input">
      <arg name="id" type="new_id" interface="zwp_text_input_v3"/>
      <arg name="seat" type="object" interface="wl_seat"/>
    </request>
  </interface>
</protocol>
